# ==============================================================================
# OmniTutor AI - Backend API Environment Configuration
# ==============================================================================
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173,http://localhost:80,http://localhost
LOG_LEVEL=info
APP_URL=http://localhost:5173

# Authentication & Session Security (Minimum 32 characters in production)
SESSION_SECRET=development_secure_session_secret_minimum_32_characters_long_12345
COOKIE_DOMAIN=

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/omnitutor

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Google Gemini API Key (Leave empty to use graceful Mock AI provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Email Provider ('mock', 'console', or 'smtp')
EMAIL_PROVIDER=mock

# Storage & Processing
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/uploads
INGESTION_QUEUE_CONCURRENCY=2

# Optional Demo Account Seeding Configuration
DEMO_USER_EMAIL=demo.student@omnitutor.ai
DEMO_USER_PASSWORD=DemoStudent123!
