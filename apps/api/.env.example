# Fastify API Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Session & Authentication Security
# Strong secret key for signing session credentials (minimum 32 characters)
SESSION_SECRET=omnitutor-session-secret-key-32-chars-minimum-required
COOKIE_DOMAIN=
APP_URL=http://localhost:5173

# Email Provider Configuration
# Options: 'mock' (safe dev sink), 'smtp' (production relay), 'console'
EMAIL_PROVIDER=mock


# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/omnitutor

# Vector Store (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# AI Provider (Google Gemini API)
# Leave empty to run in offline / graceful fallback mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
