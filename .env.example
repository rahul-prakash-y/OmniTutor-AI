# ==============================================================================
# OmniTutor AI - Comprehensive Environment Configuration Reference
# ==============================================================================
# Copy this file to `.env`, `apps/api/.env`, and `apps/web/.env` as appropriate.
# NEVER commit production credentials or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API SERVER & NETWORK SETTINGS
# ------------------------------------------------------------------------------
# Runtime environment: 'development', 'production', or 'test'
NODE_ENV=development

# Server binding host and port
PORT=4000
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated for multi-origin deployments)
# Local Vite Dev: http://localhost:5173
# Production Reverse Proxy / Nginx: http://localhost:80,http://localhost
CORS_ORIGIN=http://localhost:5173,http://localhost:80,http://localhost

# Structured logging level: 'fatal', 'error', 'warn', 'info', 'debug', 'trace'
LOG_LEVEL=info

# Public web application entry URL (used for email verification links & redirects)
APP_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION, SESSIONS & CSRF SECURITY
# ------------------------------------------------------------------------------
# Cryptographic secret used for signing session cookies and HMAC CSRF tokens.
# Requirement: Minimum 32 random characters in production.
# Generate on Linux/macOS: `openssl rand -base64 32`
# Generate on Windows PowerShell: `[Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))`
SESSION_SECRET=development_secure_session_secret_minimum_32_characters_long_12345

# Cookie domain for shared subdomains (leave empty for localhost development)
COOKIE_DOMAIN=

# ------------------------------------------------------------------------------
# 3. DATABASE (MONGODB)
# ------------------------------------------------------------------------------
# MongoDB connection URI with database name
# Local development (Docker or native): mongodb://localhost:27017/omnitutor
# Docker Compose network: mongodb://mongodb:27017/omnitutor
# MongoDB Atlas (Managed Cloud): mongodb+srv://<username>:<password>@cluster0.mongodb.net/omnitutor?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/omnitutor

# ------------------------------------------------------------------------------
# 4. VECTOR STORAGE (QDRANT)
# ------------------------------------------------------------------------------
# Qdrant HTTP REST URL
# Local development: http://localhost:6333
# Docker Compose network: http://qdrant:6333
# Qdrant Cloud Managed Cluster: https://<cluster-id>.<region>.gcp.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333

# Qdrant API key (required for Qdrant Cloud; leave empty for local non-auth Qdrant)
# Obtain from Qdrant Cloud Console -> Clusters -> Data Access Control -> API Keys
QDRANT_API_KEY=

# ------------------------------------------------------------------------------
# 5. AI ENGINE & EMBEDDINGS (GOOGLE GEMINI 2.0 FLASH)
# ------------------------------------------------------------------------------
# Google Gemini API key from Google AI Studio (https://aistudio.google.com/)
# If left empty, OmniTutor AI automatically operates in offline graceful mock mode
# (MockAIProvider and MockEmbeddingProvider) so local development & tests never fail.
GEMINI_API_KEY=

# Generation model identifier for grounded Socratic tutoring & assessments
# Recommended: gemini-2.0-flash (fast, cost-effective, high context window)
GEMINI_MODEL=gemini-2.0-flash

# Multimodal text embedding model identifier
# Dense vectors are indexed at 768 dimensions in the 'materials' Qdrant collection
EMBEDDING_MODEL=text-embedding-004

# ------------------------------------------------------------------------------
# 6. DURABLE STORAGE & INGESTION QUEUE
# ------------------------------------------------------------------------------
# Storage driver: 'local' (filesystem) or future object storage provider
STORAGE_DRIVER=local

# Relative or absolute directory for uploaded textbooks, slides, audio, video
# For Docker deployments, ensure this path is backed by a persistent named volume.
STORAGE_LOCAL_DIR=./data/uploads

# Ingestion queue concurrency worker limit (default: 2 parallel jobs)
INGESTION_QUEUE_CONCURRENCY=2

# ------------------------------------------------------------------------------
# 7. EMAIL SERVICE PROVIDER
# ------------------------------------------------------------------------------
# Email provider mode:
# - 'mock' (default for dev/test: records sent tokens in memory and logs activation links)
# - 'console' (prints rendered HTML/text directly to stdout)
# - 'smtp' (production relay for real mail transport)
EMAIL_PROVIDER=mock

# SMTP settings (required only when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="OmniTutor AI <noreply@omnitutor.ai>"

# ------------------------------------------------------------------------------
# 8. WEB CLIENT (REACT / VITE)
# ------------------------------------------------------------------------------
# API Gateway Base URL accessed by browser React application
# Local Vite Dev: http://localhost:4000/api/v1
# Production Reverse Proxy: /api/v1 (or full URL http://localhost/api/v1)
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Brand display application title
VITE_APP_NAME=OmniTutor AI

# ------------------------------------------------------------------------------
# 9. OPTIONAL DEMO ACCOUNT OVERRIDES (FOR SEEDING)
# ------------------------------------------------------------------------------
# Override email for the synthetic demo user (default: demo.student@omnitutor.ai)
DEMO_USER_EMAIL=demo.student@omnitutor.ai

# In production (NODE_ENV=production), if left unset, the seeding script
# automatically generates a cryptographically strong single-use password.
DEMO_USER_PASSWORD=DemoStudent123!
