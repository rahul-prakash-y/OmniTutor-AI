# Root Environment Reference (OmniTutor AI)
# Copy to apps/api/.env and apps/web/.env as needed

# Fastify API Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/omnitutor

# Vector Store (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# AI Provider (Google Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_APP_NAME=OmniTutor AI
